  "tools": {
    "repair": {
      "run_visible_tests": "before acting, an agent granted the tool may execute any candidate on the task's visible tests; hidden tests are never run by a tool"
    },
    "policy": "running the task's own program is the oracle for syntax, outcome, output and localize, so no pre-action tool exists for those families"
  },
  "statistics": {
