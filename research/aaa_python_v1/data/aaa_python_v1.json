    "meaning": {
      "in_distribution": "training templates, literals and names (interpolation, not memorization: exact duplicates of earlier splits are excluded)",
      "novel_literals": "training templates and names with constants from a disjoint range",
      "novel_names": "training templates and literals with every identifier drawn from a disjoint name set",
      "novel_structure": "templates never used for training",
      "novel_composition": "two training templates composed into one program with a cross-template dependency"
    }
